{
  "name": "time-tracker",
  "displayName": "Time Tracker",
  "version": "0.1.0",
  "description": "Per-project time & token tracking in your Claude Code status line, computed from session transcripts.",
  "author": {
    "name": "Fikret Tozak"
  },
  "keywords": ["statusline", "time-tracking", "tokens", "cost", "productivity"],
  "commands": ["./commands/"],
  "settings.json": {
    "statusLine": {
      "type": "command",
      "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/statusline.py\" \"${CLAUDE_PLUGIN_DATA}\"",
      "padding": 0
    }
  }
}
